# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# RAZORPAY GATEWAY CREDENTIALS: Required for secure real-time digital payments.
# Configure these with your merchant details in the Secrets panel.
RAZORPAY_KEY_ID=rzp_test_KGM123456789
RAZORPAY_KEY_SECRET=kgm_secret_123456789
RAZORPAY_WEBHOOK_SECRET=kgm_webhook_secret_987654321
